secret_number = 777

print(
"""
+===================================+
| Bem vindo ao meu jogo, trouxa!    |
| Insira um número inteiro          |
| e adivinhar o número qu'e tenho    |
| escolhidos para você.             |
| Então, qual é o número secreto?   |
+===================================+
""")
number = int(input('Numero:'))
while secret_number != number:
